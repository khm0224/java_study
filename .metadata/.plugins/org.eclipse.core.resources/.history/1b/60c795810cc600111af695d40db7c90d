<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<th:block th:replace="~{/layout/basic :: setContent(~{this::content})}">
		<th:block th:fragment="content">
			<h1 class="mt-4">
				Board List Page <span> <a
					th:href="@{/board/register}">
						<button type="button" class="btn btn-outline-primary">REGISTER
						</button>
				</a>
				</span>
			</h1>

			<table class="table table-striped">
				<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col">Title</th>
						<th scope="col">Writer</th>
						<th scope="col">Regdate</th>
					</tr>
				</thead>
				<tbody>
					<tr th:each="dto : ${result.dtoList}">
						<th scope="row"><a
							th:href="@{/board/read(gno = ${dto.bno},page= ${result.page}, keyword = ${pageRequestDTO.keyword},
							type = ${pageRequestDTO.type})}">
							[[${dto.bno}]]</a>
						</th>
						<th scope="row">[[${dto.title}]]</th>
						<th scope="row">[[${dto.writer}]]</th>
						<th scope="row">[[${dto.regDate}]]</th>
					</tr>
				</tbody>
			</table>
			<ul
				class="pagination h-100 justify-content-center align-items-center">
				<li class="page-item" th:if="${result.prev}"><a
					class="page-link"
					th:href="@{/guestbook/list(page=${result.start - 1}, keyword = ${pageRequestDTO.keyword}, type = ${pageRequestDTO.type})}">
						Previous</a></li>
				<li th:class="'page-item ' + ${result.page == page?'active':''} "
					th:each="page: ${result.pageList}"><a class="page-link"
					th:href="@{/guestbook/list(page = ${page}, keyword = ${pageRequestDTO.keyword}, type = ${pageRequestDTO.type})}">[[${page}]]</a></li>
				<li class="page-item" th:if="${result.next}"><a
					class="page-link"
					th:href="@{/guestbook/list(page= ${result.end + 1}, keyword = ${pageRequestDTO.keyword}, type = ${pageRequestDTO.type} )}">Next</a></li>
			</ul>

			<!-- css 모달 -->
			<div class="modal" tabindex="-1" role="dialog">
				<div class="modal-dialog" role="document">
					<div class="modal-content">
						<div class="modal-header">
							<h5 class="modal-title">Modal title</h5>
							<button type="button" class="close" data-dismiss="modal"
								aria-label="Close">
								<span aria-hidden="true">&times;</span>
							</button>
						</div>
						<div class="modal-body">
							<p>Modal body text goes here.</p>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-secondary"
								data-dismiss="modal">Close</button>
							<button type="button" class="btn btn-primary">Save
								changes</button>
						</div>
					</div>
				</div>
			</div>
		</th:block>
	</th:block>
</body>
</html>