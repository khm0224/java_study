	//@Test
	public void insertBoard() {
		IntStream.rangeClosed(1, 100).forEach(i -> {
			Member member = Member.builder().email("user"+i+"@aaa.com").build();
			
			Board board = Board.builder().title("Title.."+i).content("Content.."+i)
					.writer(member).build();
			
			boardRepository.save(board);
		});
	}
	
