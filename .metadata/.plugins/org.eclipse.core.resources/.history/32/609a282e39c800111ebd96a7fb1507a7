<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
</head>
<body>

<!-- 파일 업로드를 위한 파일 선택 입력창 (multiple: 다중 파일 선택 가능) -->
<input name="uploadFiles" type="file" multiple>
<!-- 파일 업로드 동작을 트리거하는 버튼 -->
<button class="uploadBtn">Upload</button>

<!-- 업로드된 이미지 미리보기와 삭제 버튼이 동적으로 추가될 영역 -->
<div class="uploadResult">

</div>

<!-- jQuery 라이브러리 CDN 로드 -->
<script
        src="https://code.jquery.com/jquery-3.5.1.min.js"
        integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0="
        crossorigin="anonymous"></script>

<script>

    // 1. [업로드 버튼 클릭 이벤트]
    $('.uploadBtn').click(function( ) {

        // 파일 데이터를 전송하기 위해 FormData 객체 생성
        var formData = new FormData();
        // 파일 input 태그 선택
        var inputFile = $("input[type='file']");
        // 선택된 파일들의 배열(FileList) 가져오기
        var files = inputFile[0].files;

        // 선택된 파일들을 순회하며 FormData에 추가
        for (var i = 0; i < files.length; i++) {
            console.log(files[i]);
            // 서버로 보낼 때 사용할 파라미터 이름("uploadFiles")과 파일 객체 매핑
            formData.append("uploadFiles", files[i]);
        }

        // 2. [AJAX를 이용한 비동기 파일 업로드 요청]
        $.ajax({
            url: '/uploadAjax',          // 파일 업로드를 처리할 서버 컨트롤러 매핑 주소
            processData: false,          // FormData 전송 시 필수: 데이터를 문자열로 변환하지 않음
            contentType: false,          // FormData 전송 시 필수: 기본 Content-Type(application/x-www-form-urlencoded) 사용 안 함
            data: formData,              // 서버로 전송할 FormData 객체
            type: 'POST',                // 전송 방식 (파일 업로드는 주로 POST 사용)
            dataType:'json',             // 서버로부터 응답받을 데이터 타입 (JSON 형식)
            success: function(result){   // 업로드 성공 시 실행되는 콜백 함수 (result: 서버가 반환한 업로드된 파일 정보 DTO 리스트)
                console.log(result);
                // 업로드된 파일 정보를 화면에 렌더링하는 함수 호출
                showUploadedImages(result);
            },
            error: function(jqXHR, textStatus, errorThrown){ // 업로드 실패 시 실행
                console.log(textStatus);
            }

        });
    });

    // 3. [서버로부터 받은 업로드 결과(DTO 리스트)를 화면에 HTML로 그려주는 함수]
    function showUploadedImages(arr){
        console.log(arr);

        var divArea = $(".uploadResult");
        var str = "";

        // 전달받은 배열(arr)을 순회하며 각 파일의 HTML 마크업 생성
        for(var i = 0; i < arr.length; i++){
            str += "<div>";
            // 썸네일 이미지를 보여주기 위해 /display 경로로 요청 (서버의 디스플레이 컨트롤러 활용)
            str += "<img src='/display?fileName=" + arr[i].thumbnailURL + "'>";
            
            // UploadResultDTO에 있던 메서드 getThumbnailURL() 를 jackson 라이브러리가 자동으로 json형태로 변환하는데
            // 이때 변환기가 getter에서 get을 빼고 앞글자를 소문자로 변환을 자동으로 해서 thumbnailURL 된다
            
            // 삭제 버튼 생성: data-name 속성에 서버에서 보낸 thumbnailURL(파일 경로)을 저장해 둠
            str += "<button class='removeBtn' data-name='" + arr[i].thumbnailURL + "'>REMOVE</button>"; 
            str += "</div>";
        }
        // 생성된 HTML 문자열을 .uploadResult 영역에 추가
        divArea.append(str);
    }

    // 4. [이벤트 위임: 동적으로 생성된 REMOVE 버튼 클릭 시 처리]
    // 페이지 로딩 시점에 없던 버튼이므로, 부모 요소인 $(".uploadResult")를 통해 이벤트를 바인딩함
    $(".uploadResult").on("click", ".removeBtn", function(e){
        var target = $(this);
        // 버튼의 data-name 속성에 저장된 파일 경로(thumbnailURL)를 가져옴
        var fileName = target.data("name");
        // 버튼이 속해 있는 부모 div 태그를 찾음 (삭제 후 해당 화면 영역을 지우기 위함)
        var targetDiv = $(this).closest("div");

        console.log(fileName);

        // 서버에 파일 삭제 요청 전송
        $.post('/removeFile', {fileName: fileName}, function(result){
            console.log(result);
            // 서버에서 파일 삭제가 정상적으로 처리되어 true를 반환하면
            if(result === true){
                // 화면 상에서 해당 파일의 이미지와 버튼이 들어있는 div 영역을 제거
                targetDiv.remove();
            }
        });
    });

</script>

</body>
</html>