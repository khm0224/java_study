package com.fullstack.controller;

import java.io.File;
import java.net.URLDecoder;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;
import java.util.UUID;

import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.util.FileCopyUtils;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestParam;
import org.springframework.web.bind.annotation.RestController;
import org.springframework.web.multipart.MultipartFile;
import com.fullstack.dto.UploadResultDTO;
import lombok.extern.log4j.Log4j2;
import net.coobird.thumbnailator.Thumbnailator;

@RestController // RESTful 웹 서비스 컨트롤러 지정 (반환값이 JSON 등의 데이터로 변환됨)
@Log4j2         // Lombok을 이용한 로그 기록(log) 기능 활성화
public class UploadController {
	
	// application.properties 등에 설정된 파일 업로드 기본 경로를 주입받음
	@Value("${com.fullstack.upload.path}")
	private String uploadPath;
	
	// 1. [서버에 저장된 이미지를 브라우저 화면에 보여주기(출력) 위한 GET 요청 처리]
	@GetMapping("/display")
	public ResponseEntity<byte[]> getFile(@RequestParam("fileName") String fileName){
		ResponseEntity<byte[]> result = null;
		try {
			// URL에 인코딩되어 전달된 파일 경로를 원래 문자열로 디코딩
			String srcFileName = URLDecoder.decode(fileName, "UTF-8");
			log.info("fileName : " + fileName);
			
			// 업로드 기본 경로와 파일 경로를 합쳐서 실제 파일 객체 생성
			File file = new File(uploadPath + File.separator + srcFileName);
			log.info("file : " + file);
			
			HttpHeaders headers = new HttpHeaders();
			
			// 파일의MIME 타입(예: image/jpeg, image/png 등)을 감지하여 HTTP 헤더에 설정
			headers.add("Content-Type", Files.probeContentType(file.toPath()));
			
			// 파일을 바이트 배열로 읽어와서 HTTP 응답 객체(ResponseEntity)로 반환
			result = new ResponseEntity<>(FileCopyUtils.copyToByteArray(file),
					headers, HttpStatus.OK);
		} catch (Exception e) {
			log.error(e.getMessage());
			return new ResponseEntity<>(HttpStatus.INTERNAL_SERVER_ERROR);
		}
		return result;
	}
	
	// 2. [Ajax를 통한 파일 업로드 요청 처리]
	@PostMapping("/uploadAjax")
	public ResponseEntity<List<UploadResultDTO>> uploadFile(@RequestParam("uploadFiles") MultipartFile[] uploadFiles) {
		List<UploadResultDTO> resultDTOList = new ArrayList<>();
		
		// 전달받은 파일들을 하나씩 순회하며 처리
		for(MultipartFile uploadFile : uploadFiles) {
			
			// 업로드된 파일이 이미지 파일인지 검증 (이미지가 아니면 FORBIDDEN 상태 코드 반환)
			if(uploadFile.getContentType().startsWith("image") == false) {
				log.warn("이미지 파일이 아님");
				return new ResponseEntity<>(HttpStatus.FORBIDDEN);
			}
			
			// 원본 파일 이름 가져오기
			String originalName = uploadFile.getOriginalFilename();
			// 경로(크롬 브라우저 등에서 절대 경로로 들어오는 경우 방지)를 제외한 순수 파일명만 추출
			String fileName = originalName.substring(originalName.lastIndexOf("\\") + 1);
			
			// 오늘 날짜를 기준으로 하위 폴더 경로 생성 (예: 2026/06/15)
			String folderPath = makeFolder();
			
			// 파일 이름 중복 방지를 위한 UUID 생성
			String uuid = UUID.randomUUID().toString();
			
			// 원본 파일이 저장될 전체 경로 설정 (업로드 경로 + 날짜 폴더 + UUID_파일명)
			String saveName = uploadPath + File.separator + folderPath + File.separator
					+ uuid + "_" + fileName;
			
			Path savePath = Paths.get(saveName);
			try {
				// 원본 파일을 지정한 경로에 실제 저장
				uploadFile.transferTo(savePath);
				
				// 썸네일 파일 이름 지정 (앞에 's_' 붙임)
				String thumbaniSaveName = uploadPath + File.separator +folderPath + File.separator + "s_" + uuid + "_" + fileName;
				// 썸네일 파일 객체 생성
				File thumbnailFile = new File(thumbaniSaveName);
				// Thumbnailator 라이브러리를 이용해 100x100 크기의 썸네일 생성
				Thumbnailator.createThumbnail(savePath.toFile(), thumbnailFile, 100, 100);
				
				// 업로드 성공한 파일 정보를 DTO에 담아 리스트에 추가
				resultDTOList.add(new UploadResultDTO(fileName, uuid, folderPath));
			} catch (Exception e) {
				e.printStackTrace();
			}
		}
		// 업로드된 파일들의 정보가 담긴 DTO 리스트를 JSON 형태로 반환 (상태 코드 OK)
		return new ResponseEntity<>(resultDTOList, HttpStatus.OK);
	}
	
	// 3. [오늘 날짜를 기반으로 폴더를 생성하고 경로를 반환하는 유틸 메서드]
	private String makeFolder() {
		// 연/월/일 포맷 생성 (예: 2026/06/15)
		String str = LocalDate.now().format(DateTimeFormatter.ofPattern("yyyy/MM/dd"));
		// OS에 맞게 슬래시(/)를 파일 구분자(File.separator)로 변환
		String folderPath = str.replace("/", File.separator);
		
		// 업로드 기본 경로와 날짜 폴더 경로를 합쳐서 디렉토리 객체 생성
		File uploadPathFolder = new File(uploadPath, folderPath);
		
		// 해당 폴더가 존재하지 않으면 디렉토리 생성 (중간에 없는 폴더들까지 한 번에 생성)
		if(uploadPathFolder.exists() == false) {
			uploadPathFolder.mkdirs();
		}
		return folderPath;
	}
	
	@PostMapping("/removeFile")
	public ResponseEntity<Boolean> removeFile() {
		
	}
}