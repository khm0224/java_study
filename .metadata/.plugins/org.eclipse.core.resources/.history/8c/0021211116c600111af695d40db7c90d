				Optional<Board> result = boardRepository.findById(BoardDTO.getBno());
				if(result.isPresent()) {
					BoardDTO entity = result.get();
					
					// 엔티티에 수정할 내용 set
					entity.changeContent(boardDTO.getContent());
					entity.changeTitle(boardDTO.getTitle());
					
					boardRepository.save(entity);
				}
	}

