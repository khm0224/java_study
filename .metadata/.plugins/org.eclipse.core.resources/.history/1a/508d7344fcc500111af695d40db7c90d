package com.fullstack.repository;

import java.util.Arrays;
import java.util.List;
import java.util.Optional;
import java.util.stream.IntStream;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.data.domain.Sort;

import com.fullstack.entity.Board;
import com.fullstack.entity.BoardDTO;
import com.fullstack.entity.Member;
import com.fullstack.service.BoardService;
import com.fullstack.service.BoardServiceImpl;

@SpringBootTest
public class BoardRepositoryTests {
	@Autowired
	private BoardRepository boardRepository;
	
	//@Test
	public void insertBoard() {
		IntStream.rangeClosed(1, 100).forEach(i -> {
			Member member = Member.builder().email("user"+i+"@aaa.com").build();
			
			Board board = Board.builder().title("Title.."+i).content("Content.."+i)
					.writer(member).build();
			
			boardRepository.save(board);
		});
	}
	
	//@Transactional // 이 친구를 사용하면 쿼리문을 여러번 쏘개 해줌
	//@Test
	public void testRead() {
		Board board = null;
		Optional<Board> result = boardRepository.findById(100L);
		
		board = result.get();
		System.out.println(board);
		System.out.println(board.getWriter());
	}
	
	//@Test
	public void testReadWriter() {
		Object result = boardRepository.getBoardWithWriter(100L);
		
		Object[] arr = (Object[])result;
		System.out.println("-----------------");
		System.out.println(Arrays.toString(arr));
	}
	
	//@Test
	public void testReadReply() {
		List<Object[]> result = boardRepository.getBoardWithReply(1L);
		
		for(Object[] arr : result) {
			System.out.println(Arrays.toString(arr));
		}
	}
	
	//@Test
	public void testWithReplyCount() {
		Pageable pageable = PageRequest.of(1, 10, Sort.by("bno").descending());
		
		Page<Object[]> result = boardRepository.getBoardWithReplyCount(pageable);
		result.get().forEach(row -> {
			Object[] arr= (Object[])row;
			System.out.println(Arrays.toString(arr));
		});
	}
	
	@Test
	public void newInsertBoard() {
		BoardService boardService = new BoardServiceImpl(boardRepository);
		BoardDTO dto = BoardDTO.builder().writerEmail("user101@aaa.com").title("새글제목")
				.content("새글내용").writerName("사람이름").build();
		Long pk = boardService.register(dto);
		
		Optional<Board> result = boardRepository.findById(pk);
		
		board = result.get();
		System.out.println(board);
		System.out.println(board.getWriter());
	}
}
